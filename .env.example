# ============================================
# AI Gateway Platform - 环境变量配置
# ============================================
# 使用方法：
#   1. 复制此文件为 .env
#   2. 修改下面的配置值
#   3. 运行 ./deploy.sh

# OpenAI API Key（必填）
OPENAI_API_KEY=sk-your-openai-api-key-here

# MySQL 配置（可选，默认值已在 docker-compose.yml 中设置）
# MYSQL_ROOT_PASSWORD=123456
# MYSQL_DATABASE=ai_gateway

# Redis 配置（可选，默认值已在 docker-compose.yml 中设置）
# REDIS_PASSWORD=123321

# 应用端口（可选，默认 8080）
# APP_PORT=8080
