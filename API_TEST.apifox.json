{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Gateway Platform API",
    "version": "2.0.0",
    "description": "AI模型调度网关平台 - 前后端分离。统一响应 {code,message,data,timestamp}，HTTP Status=200，code===200即成功。\n\n安全升级：所有非公开接口需 X-User-Token Header（登录获取UUID格式Token，24h有效）"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "本地开发环境"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "用户注册",
        "tags": [
          "01-认证"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "username": "newuser",
                "password": "admin123",
                "email": "new@test.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "返回UserInfoVO"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "用户登录（返回UUID Token，24h有效）",
        "tags": [
          "01-认证"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "zhangsan",
                "password": "admin123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "返回token+userInfo，token用于后续请求Header X-User-Token"
          }
        }
      }
    },
    "/auth/userinfo": {
      "get": {
        "summary": "查询用户信息（公开）",
        "tags": [
          "01-认证"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 7
          }
        ],
        "responses": {
          "200": {
            "description": "返回UserInfoVO"
          }
        }
      }
    },
    "/auth/balance": {
      "get": {
        "summary": "查询余额（公开）",
        "tags": [
          "01-认证"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 7
          }
        ],
        "responses": {
          "200": {
            "description": "data=BigDecimal数字"
          }
        }
      }
    },
    "/user/recharge": {
      "post": {
        "summary": "充值（需Token，身份自动识别）",
        "tags": [
          "02-用户"
        ],
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            },
            "example": 10,
            "description": "充值金额(美元)"
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6",
            "description": "登录返回的token"
          }
        ],
        "responses": {
          "200": {
            "description": "充值成功"
          }
        }
      }
    },
    "/user/info": {
      "get": {
        "summary": "查询自己的信息（需Token）",
        "tags": [
          "02-用户"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "返回UserInfoVO"
          }
        }
      }
    },
    "/user/balance": {
      "get": {
        "summary": "查询自己的余额（需Token）",
        "tags": [
          "02-用户"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "data=BigDecimal数字"
          }
        }
      }
    },
    "/api-key/generate": {
      "post": {
        "summary": "生成API Key（需Token）",
        "tags": [
          "03-API Key"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "MyKey"
                  },
                  "rateLimit": {
                    "type": "integer",
                    "example": 200
                  }
                }
              },
              "example": {
                "name": "ProductionKey",
                "rateLimit": 200
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "返回ApiKeyInfoVO"
          }
        }
      }
    },
    "/api-key/list": {
      "get": {
        "summary": "查询自己的API Key列表（需Token）",
        "tags": [
          "03-API Key"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "返回ApiKeyInfoVO数组"
          }
        }
      }
    },
    "/api-key/{id}": {
      "delete": {
        "summary": "删除API Key（需Token，校验归属）",
        "tags": [
          "03-API Key"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/api-key/{id}/enable": {
      "put": {
        "summary": "启用API Key（需Token）",
        "tags": [
          "03-API Key"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 6
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "启用成功"
          }
        }
      }
    },
    "/api-key/{id}/disable": {
      "put": {
        "summary": "禁用API Key（需Token）",
        "tags": [
          "03-API Key"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "禁用成功"
          }
        }
      }
    },
    "/api-key/{id}/rate-limit": {
      "put": {
        "summary": "更新限流阈值（需Token）",
        "tags": [
          "03-API Key"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "rateLimit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 500
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      }
    },
    "/admin/admins": {
      "get": {
        "summary": "获取管理员列表（需Token+SUPER_ADMIN）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "返回AdminInfoVO数组"
          }
        }
      }
    },
    "/admin/users": {
      "get": {
        "summary": "获取所有用户（需Token+ADMIN+）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "返回AdminInfoVO数组"
          }
        }
      }
    },
    "/admin/user/{userId}": {
      "get": {
        "summary": "获取用户详情（需Token+ADMIN+）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 9
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "返回AdminInfoVO"
          }
        }
      }
    },
    "/admin/user/status": {
      "post": {
        "summary": "禁用/启用用户（需Token+ADMIN+）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 11,
            "description": "目标用户ID"
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1,
            "description": "0=禁用,1=启用"
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功"
          }
        }
      }
    },
    "/admin/assign-role": {
      "post": {
        "summary": "分配管理员角色（需Token+SUPER_ADMIN）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "role"
                ],
                "properties": {
                  "userId": {
                    "type": "integer",
                    "example": 8
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "SUPER_ADMIN"
                    ],
                    "example": "ADMIN"
                  }
                }
              },
              "example": {
                "userId": 8,
                "role": "ADMIN"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "角色分配成功"
          }
        }
      }
    },
    "/admin/revoke-role": {
      "post": {
        "summary": "取消管理员角色（需Token+SUPER_ADMIN）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 8
          },
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "角色取消成功"
          }
        }
      }
    },
    "/admin/set-free-strategy": {
      "post": {
        "summary": "设置免费策略（需Token+SUPER_ADMIN）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "freeApiStrategy"
                ],
                "properties": {
                  "userId": {
                    "type": "integer",
                    "example": 9
                  },
                  "freeApiStrategy": {
                    "type": "string",
                    "enum": [
                      "UNLIMITED",
                      "QUOTA_BASED",
                      "COUNT_LIMITED",
                      "TIME_LIMITED",
                      "MODEL_SPECIFIC"
                    ],
                    "example": "UNLIMITED"
                  },
                  "freeQuota": {
                    "type": "number",
                    "example": 100
                  },
                  "dailyCallLimit": {
                    "type": "integer",
                    "example": 50
                  },
                  "monthlyCallLimit": {
                    "type": "integer",
                    "example": 1000
                  },
                  "freeStrategyStartTime": {
                    "type": "string",
                    "example": "2026-06-01T00:00:00"
                  },
                  "freeStrategyEndTime": {
                    "type": "string",
                    "example": "2026-07-01T23:59:59"
                  },
                  "allowedFreeModels": {
                    "type": "string",
                    "example": "[\"deepseek-v4-pro\",\"deepseek-v4-flash\"]"
                  }
                }
              },
              "example": {
                "userId": 9,
                "freeApiStrategy": "UNLIMITED"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "策略设置成功"
          }
        }
      }
    },
    "/admin/stats": {
      "get": {
        "summary": "系统统计12项实时指标（需Token+ADMIN+）",
        "tags": [
          "04-管理员"
        ],
        "parameters": [
          {
            "name": "X-User-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "返回SystemStatsVO"
          }
        }
      }
    },
    "/chat/completions": {
      "post": {
        "summary": "非流式对话 - data=AI回复纯文本",
        "tags": [
          "05-聊天"
        ],
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "sk-2adbdb4f5ae04cacb9ea0466ac4b23f0"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "example": {
                "model": "deepseek-v4-pro",
                "messages": [
                  {
                    "role": "user",
                    "content": "用一句话介绍Java"
                  }
                ],
                "maxTokens": 200,
                "temperature": 0.7
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "data=AI回复纯文本字符串"
          }
        }
      }
    },
    "/chat/stream": {
      "post": {
        "summary": "流式对话SSE - event:message→{content} | event:done→{finished,inputTokens,outputTokens,cost} | event:error→错误字符串",
        "tags": [
          "05-聊天"
        ],
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "sk-2adbdb4f5ae04cacb9ea0466ac4b23f0"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "example": {
                "model": "deepseek-v4-pro",
                "messages": [
                  {
                    "role": "user",
                    "content": "你好"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE流式响应(text/event-stream)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "newuser"
          },
          "password": {
            "type": "string",
            "example": "admin123"
          },
          "email": {
            "type": "string",
            "example": "new@test.com"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "zhangsan"
          },
          "password": {
            "type": "string",
            "example": "admin123"
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "deepseek-v4-pro",
              "deepseek-v4-flash",
              "deepseek-chat"
            ],
            "example": "deepseek-v4-pro"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "maxTokens": {
            "type": "integer",
            "example": 200,
            "description": "选填,1-4096"
          },
          "temperature": {
            "type": "number",
            "example": 0.7,
            "description": "选填,0.0-2.0"
          }
        }
      },
      "UserInfoVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 7
          },
          "username": {
            "type": "string",
            "example": "zhangsan"
          },
          "email": {
            "type": "string",
            "example": "zhangsan@ai.com"
          },
          "balance": {
            "type": "number",
            "example": 50
          },
          "status": {
            "type": "integer",
            "example": 1,
            "description": "1=启用 0=禁用"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN",
              "SUPER_ADMIN"
            ],
            "example": "ADMIN"
          },
          "freeApiStrategy": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-12T17:30:00"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-12T17:30:00"
          }
        }
      },
      "ApiKeyInfoVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "apiKey": {
            "type": "string",
            "example": "sk-3457a754a5534a668f87fb33c367e6f0"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "MyKey"
          },
          "status": {
            "type": "integer",
            "example": 1
          },
          "rateLimit": {
            "type": "integer",
            "example": 200
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-12T17:30:00"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        }
      },
      "AdminInfoVO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 9
          },
          "username": {
            "type": "string",
            "example": "wangwu"
          },
          "email": {
            "type": "string",
            "example": "wangwu@ai.com"
          },
          "balance": {
            "type": "number",
            "example": 20
          },
          "status": {
            "type": "integer",
            "example": 1
          },
          "role": {
